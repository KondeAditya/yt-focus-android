{
  "name": "yt-focus",
  "version": "1.0.0",
  "description": "Distraction-free YouTube browsing experience",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:ios": "eas build --platform ios",
    "build:ios:preview": "eas build --profile preview --platform ios",
    "build:ios:dev": "eas build --profile development --platform ios",
    "submit:ios": "eas submit --platform ios",
    "build:android": "eas build --platform android",
    "build:android:preview": "eas build --profile preview --platform android",
    "build:android:dev": "eas build --profile development --platform android",
    "build:android:apk": "eas build --profile preview --platform android",
    "submit:android": "eas submit --platform android",
    "lint": "expo lint",
    "ts:check": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "~14.0.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.8",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.4",
    "expo-linking": "~7.0.0",
    "expo-screen-orientation": "~8.0.0",
    "expo-splash-screen": "~0.29.24",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-webview": "13.12.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~18.3.0",
    "typescript": "~5.3.0"
  },
  "private": true
}
